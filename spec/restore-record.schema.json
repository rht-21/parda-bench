{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RestoreRecord",
  "description": "One line of `restore.jsonl`.",
  "type": "object",
  "properties": {
    "outcome": {
      "$ref": "#/$defs/RestoreOutcome"
    },
    "scenario_id": {
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "outcome"
  ],
  "$defs": {
    "CheckFailure": {
      "type": "object",
      "properties": {
        "check": {
          "$ref": "#/$defs/CheckKind"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "check",
        "detail"
      ]
    },
    "CheckKind": {
      "oneOf": [
        {
          "description": "No `pii` value reaches the upstream, verbatim or with separators and case changed.",
          "type": "string",
          "const": "no_leak_upstream"
        },
        {
          "description": "The client sees the scripted reply with every placeholder replaced by its real value.",
          "type": "string",
          "const": "restored_exact"
        },
        {
          "description": "The client sees no whole or partial placeholder.",
          "type": "string",
          "const": "no_placeholder_fragment"
        },
        {
          "description": "A value gets the same placeholder every time it is sent, within and across turns.",
          "type": "string",
          "const": "placeholder_stable_across_turns"
        },
        {
          "description": "Tool-call arguments, and text replies that are JSON as scripted, are still valid JSON after restoring.",
          "type": "string",
          "const": "json_valid"
        },
        {
          "description": "An upstream error reaches the client as an error with the same status.",
          "type": "string",
          "const": "fails_closed"
        }
      ]
    },
    "RestoreOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "pass"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "client_excerpt": {
              "type": "string"
            },
            "failures": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CheckFailure"
              }
            },
            "status": {
              "type": "string",
              "const": "fail"
            },
            "upstream_excerpt": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "failures",
            "upstream_excerpt",
            "client_excerpt"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "const": "not_applicable"
            }
          },
          "required": [
            "status",
            "reason"
          ]
        }
      ]
    }
  }
}
