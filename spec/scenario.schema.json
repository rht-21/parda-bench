{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario",
  "description": "One restore test, authored as `scenarios/<category>/<id>.toml`.\n\n`pii` holds the real values; segments refer to them by index (`slot`). The mock upstream learns each slot's\nplaceholder by aligning the masked request it receives against the input's literal segments.",
  "type": "object",
  "properties": {
    "api": {
      "$ref": "#/$defs/Api"
    },
    "category": {
      "$ref": "#/$defs/Category"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CheckKind"
      }
    },
    "description": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "pii": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stream": {
      "type": "boolean"
    },
    "tools": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ToolDefinition"
      }
    },
    "turns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Turn"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "description",
    "api",
    "stream",
    "pii",
    "turns",
    "checks"
  ],
  "$defs": {
    "Api": {
      "type": "string",
      "enum": [
        "openai_chat",
        "anthropic_messages"
      ]
    },
    "Category": {
      "type": "string",
      "enum": [
        "basic",
        "streaming_split",
        "tool_calls",
        "multi_turn",
        "placeholder_mangling",
        "repeats_adjacency",
        "unicode",
        "structured_output",
        "failure_behaviour"
      ]
    },
    "CheckKind": {
      "oneOf": [
        {
          "description": "No `pii` value reaches the upstream, verbatim or with separators and case changed.",
          "type": "string",
          "const": "no_leak_upstream"
        },
        {
          "description": "The client sees the scripted reply with every placeholder replaced by its real value.",
          "type": "string",
          "const": "restored_exact"
        },
        {
          "description": "The client sees no whole or partial placeholder.",
          "type": "string",
          "const": "no_placeholder_fragment"
        },
        {
          "description": "A value gets the same placeholder every time it is sent, within and across turns.",
          "type": "string",
          "const": "placeholder_stable_across_turns"
        },
        {
          "description": "Tool-call arguments, and text replies that are JSON as scripted, are still valid JSON after restoring.",
          "type": "string",
          "const": "json_valid"
        },
        {
          "description": "An upstream error reaches the client as an error with the same status.",
          "type": "string",
          "const": "fails_closed"
        }
      ]
    },
    "InputSegment": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "slot": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "slot"
          ]
        }
      ]
    },
    "Mangle": {
      "type": "string",
      "enum": [
        "lowercase",
        "uppercase",
        "strip_delimiters",
        "space_padded"
      ]
    },
    "Reply": {
      "description": "What the mock upstream sends back. Each inner `Vec<ReplySegment>` is one SSE chunk when streaming.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "chunks": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/ReplySegment"
                }
              }
            },
            "kind": {
              "type": "string",
              "const": "text"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "chunks"
          ]
        },
        {
          "type": "object",
          "properties": {
            "argument_chunks": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/ReplySegment"
                }
              }
            },
            "call_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "tool_call"
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "call_id",
            "name",
            "argument_chunks"
          ]
        },
        {
          "type": "object",
          "properties": {
            "body": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "http_error"
            },
            "status": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "status",
            "body"
          ]
        }
      ]
    },
    "ReplySegment": {
      "description": "Literal text, or (part of) the placeholder the tool chose for `slot`, optionally altered the way models do.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "from": {
              "description": "Char range of the placeholder to emit; omitted bounds mean start/end of the placeholder.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint",
              "minimum": 0
            },
            "mangle": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Mangle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "slot": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "to": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "slot"
          ]
        }
      ]
    },
    "ToolDefinition": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parameters": true
      },
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "parameters"
      ]
    },
    "Turn": {
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/TurnInput"
        },
        "reply": {
          "$ref": "#/$defs/Reply"
        }
      },
      "additionalProperties": false,
      "required": [
        "input",
        "reply"
      ]
    },
    "TurnInput": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "user"
            },
            "message": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/InputSegment"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "call_id": {
              "type": "string"
            },
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/InputSegment"
              }
            },
            "kind": {
              "type": "string",
              "const": "tool_result"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "call_id",
            "content"
          ]
        }
      ]
    }
  }
}
