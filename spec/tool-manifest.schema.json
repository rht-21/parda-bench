{
  "$defs": {
    "Capability": {
      "enum": [
        "detect",
        "mask",
        "unmask",
        "unmask_stream",
        "proxy"
      ],
      "title": "Capability",
      "type": "string"
    },
    "EntityType": {
      "description": "The closed set of entity types Parda Bench labels and scores.",
      "enum": [
        "AADHAAR",
        "AADHAAR_VID",
        "PAN",
        "GSTIN",
        "IFSC",
        "UPI_ID",
        "PHONE",
        "EMAIL",
        "PAYMENT_CARD",
        "PASSPORT",
        "VOTER_ID",
        "VEHICLE_REGISTRATION",
        "PERSON_NAME",
        "ADDRESS",
        "DATE_OF_BIRTH"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "HttpApi": {
      "additionalProperties": false,
      "description": "Service that takes each adapter request as a JSON POST to `base_url`.",
      "properties": {
        "kind": {
          "const": "http-api",
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "items": {
            "type": "string"
          },
          "title": "Start",
          "type": "array"
        },
        "base_url": {
          "title": "Base Url",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "start",
        "base_url"
      ],
      "title": "HttpApi",
      "type": "object"
    },
    "HttpProxy": {
      "additionalProperties": false,
      "description": "OpenAI/Anthropic-compatible proxy; the harness sets `upstream_env` to the mock upstream URL.",
      "properties": {
        "kind": {
          "const": "http-proxy",
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "items": {
            "type": "string"
          },
          "title": "Start",
          "type": "array"
        },
        "base_url": {
          "title": "Base Url",
          "type": "string"
        },
        "upstream_env": {
          "title": "Upstream Env",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "start",
        "base_url",
        "upstream_env"
      ],
      "title": "HttpProxy",
      "type": "object"
    },
    "Stdio": {
      "additionalProperties": false,
      "description": "Long-lived worker speaking the NDJSON adapter protocol on stdin/stdout.",
      "properties": {
        "kind": {
          "const": "stdio",
          "title": "Kind",
          "type": "string"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "command"
      ],
      "title": "Stdio",
      "type": "object"
    },
    "ToolConfig": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tool-specific config file, relative to the tool directory.",
          "title": "File"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Env",
          "type": "object"
        }
      },
      "title": "ToolConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Contents of `tools/<name>/tool.toml`. Commands run with the tool directory as working directory.",
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "commit": {
      "title": "Commit",
      "type": "string"
    },
    "license": {
      "title": "License",
      "type": "string"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "homepage": {
      "title": "Homepage",
      "type": "string"
    },
    "transport": {
      "discriminator": {
        "mapping": {
          "http-api": "#/$defs/HttpApi",
          "http-proxy": "#/$defs/HttpProxy",
          "stdio": "#/$defs/Stdio"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Stdio"
        },
        {
          "$ref": "#/$defs/HttpProxy"
        },
        {
          "$ref": "#/$defs/HttpApi"
        }
      ],
      "title": "Transport"
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "entity_map": {
      "additionalProperties": {
        "$ref": "#/$defs/EntityType"
      },
      "description": "Tool's own label to Parda entity type; labels missing here are scored as unmapped, never dropped.",
      "title": "Entity Map",
      "type": "object"
    },
    "configs": {
      "additionalProperties": {
        "$ref": "#/$defs/ToolConfig"
      },
      "description": "Named configurations; `default` is required, `tuned` only when the tool's docs recommend one.",
      "title": "Configs",
      "type": "object"
    }
  },
  "required": [
    "name",
    "version",
    "commit",
    "license",
    "language",
    "homepage",
    "transport",
    "capabilities",
    "entity_map",
    "configs"
  ],
  "title": "ToolManifest",
  "type": "object"
}
