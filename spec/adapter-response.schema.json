{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdapterResponse",
  "description": "Tool worker to harness; `id` echoes the request.",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "oneOf": [
    {
      "description": "`elapsed_ns` is measured inside the worker, so it excludes IPC overhead.",
      "type": "object",
      "properties": {
        "elapsed_ns": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "result": {
          "$ref": "#/$defs/AdapterResult"
        },
        "status": {
          "type": "string",
          "const": "ok"
        }
      },
      "required": [
        "status",
        "elapsed_ns",
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "const": "error"
        }
      },
      "required": [
        "status",
        "message"
      ]
    }
  ],
  "required": [
    "id"
  ],
  "$defs": {
    "AdapterResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "capabilities": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Capability"
              }
            },
            "op": {
              "type": "string",
              "const": "hello"
            },
            "tool_version": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "tool_version",
            "capabilities"
          ]
        },
        {
          "type": "object",
          "properties": {
            "entities": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DetectedEntity"
              }
            },
            "op": {
              "type": "string",
              "const": "detect"
            }
          },
          "required": [
            "op",
            "entities"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "mask"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "unmask"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "text"
          ]
        },
        {
          "description": "Text safe to emit now; the tool may hold back a partial placeholder until a later chunk.",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "unmask_stream"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "shutdown"
            }
          },
          "required": [
            "op"
          ]
        }
      ]
    },
    "Capability": {
      "type": "string",
      "enum": [
        "detect",
        "mask",
        "unmask",
        "unmask_stream",
        "proxy"
      ]
    },
    "DetectedEntity": {
      "description": "An entity as the tool reports it, before mapping to `EntityType`.",
      "type": "object",
      "properties": {
        "end": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "label": {
          "type": "string"
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "start": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end",
        "label"
      ]
    }
  }
}
