#!/bin/sh
# Mirrors CI's format check so unformatted Rust never reaches a push. Enable with:
#   git config core.hooksPath .githooks
if ! cargo fmt --all -- --check >/dev/null 2>&1; then
    echo "pre-commit: Rust code is not formatted. Run 'cargo fmt --all', then stage and commit again." >&2
    exit 1
fi
